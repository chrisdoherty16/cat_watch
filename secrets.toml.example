# Local development only. Copy this file to .streamlit/secrets.toml and fill
# in real values. NEVER commit the real secrets.toml to git.
#
# On Azure App Service (or any other host), do NOT use this file at all —
# instead set these same names as Application Settings / environment
# variables in the hosting platform. app.py reads secrets.toml first and
# falls back to environment variables automatically (see secret_value()).
#
# Every key below is OPTIONAL. CatWatch runs fully without any of them — you
# only need to fill in a key if you want the "Ask CatWatch" AI chat feature
# enabled. The app tries providers in this order and stops at the first one
# that works: Gemini -> Groq -> Meta Llama -> OpenRouter.

GEMINI_API_KEY = ""

GROQ_API_KEY = ""
GROQ_MODEL = ""        # optional, defaults to "openai/gpt-oss-120b"

LLAMA_API_KEY = ""
LLAMA_MODEL = ""       # required alongside LLAMA_API_KEY if using Meta Llama

OPENROUTER_API_KEY = ""
